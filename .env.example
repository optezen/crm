# Never commit actual keys. Without Supabase values the app shows setup notices and persists nothing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin of this app (used for the email sign-in redirect). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
# Optional: enables AI-assisted setup (drafts a workspace configuration from a business description; always reviewed and approved by an owner).
# Server-side only. Without it the app simply does not offer AI. Leave unset to disable.
# ANTHROPIC_API_KEY=
# OPTIZEN_AI_MODEL=claude-sonnet-5-5
# OPTIZEN_AI_PROVIDER=anthropic   # the only provider implemented today; the AI assistant AND onboarding drafts use it

# Automation worker only (worker/automation-worker.mjs, e.g. on Fly.io). SERVICE ROLE KEY: never set it on the web app / Vercel project.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Integration Hub. Website Forms needs NONE of these. Meta Lead Ads / WhatsApp need the ones listed in docs/INTEGRATIONS.md.
# INTEGRATION_ENCRYPTION_KEY=      # 32 random bytes, base64 (openssl rand -base64 32). Web app AND integration worker. Never in the database.
# INTEGRATION_GATEWAY_SECRET=      # >= 32 chars. Web app only; its hash is registered once with: select public.integration_set_gateway_secret('...') (service role / SQL editor)
# META_APP_ID=
# META_APP_SECRET=                 # web app: verifies webhook signatures and the OAuth code exchange
# META_WEBHOOK_VERIFY_TOKEN=       # any random string; enter the same value in the Meta app's webhook settings
# META_GRAPH_VERSION=v21.0         # set to a currently supported Graph API version
