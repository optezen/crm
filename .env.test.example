# LIVE integration tests only. Copy to .env.test.local (git-ignored). Use a LOCAL stack or a DEDICATED throwaway project:
# the tests create and delete users/organizations. Never point these at production.
# Local (`supabase start` prints these):
SUPABASE_TEST_URL=http://127.0.0.1:54321
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
# Only for a remote throwaway project:
# SUPABASE_TEST_ALLOW_REMOTE=1
# SUPABASE_TEST_STAGING_REF=abcdefghijklmnop    # REQUIRED with ALLOW_REMOTE: the staging project ref; must match the URL's ref (docs/STAGING.md)
# SUPABASE_PRODUCTION_REF=                       # optional: the production ref; the tests refuse to run if the URL matches it
# Running app for tests/integration/app-routes.itest.mjs (must use the same Supabase project):
APP_URL=http://localhost:3000
