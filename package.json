{
  "name": "optizen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --env-file-if-exists=.env.test.local tests/integration/run.mjs",
    "test:browser": "node tests/browser/run.mjs",
    "test:concurrency": "node --test --test-concurrency=1 tests/concurrency/concurrency.test.mjs",
    "test:security": "node --test --test-concurrency=1 tests/concurrency/security.test.mjs",
    "test:workers": "node --test --test-concurrency=1 tests/concurrency/workers.test.mjs",
    "test:perf": "node --test --test-concurrency=1 --test-timeout=600000 tests/concurrency/performance.test.mjs",
    "test:e2e:staging": "node --env-file-if-exists=.env.test.local --test --test-concurrency=1 tests/e2e/staging.e2e.mjs",
    "test:provisioning": "node --test --test-concurrency=1 --test-timeout=300000 tests/concurrency/provisioning.test.mjs",
    "test:hosted-layout": "PG_LAYOUT=supabase npm run test:concurrency && PG_LAYOUT=supabase npm run test:security && PG_LAYOUT=supabase npm run test:workers",
    "db:plan": "node scripts/db-apply.mjs",
    "db:validate": "node scripts/db-validate.mjs",
    "preflight": "node scripts/preflight.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "^16.0.0",
    "pdfkit": "^0.17.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.14.1",
    "embedded-postgres": "^18.7.0-beta.19",
    "pg": "^8.23.1",
    "playwright": "^1.49.1",
    "typescript": "^5.9.0"
  }
}
